{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardAutoclose": true,
  "extends": [
    "config:recommended",
    ":rebaseStalePrs",
    "schedule:weekly",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "labels": [
    "renovate"
  ],
  "pre-commit": {
    "enabled": true,
    "schedule": [
      "every month"
    ]
  },
  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    },
    {
      "automerge": true,
      "dependencyDashboardApproval": true,
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "groupName": "github actions (major)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "digest": {
        "dependencyDashboardApproval": true
      }
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "enabled": true,
      "groupName": "go indirect dependencies"
    },
    {
      "description": "constrained by the deprecated github.com/google/generative-ai-go, whose build breaks against newer go/ai; remove after migrating to google.golang.org/genai",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "cloud.google.com/go/ai"
      ],
      "enabled": false
    },
    {
      "groupName": "aws-go-sdk-v2 monorepo",
      "groupSlug": "aws-go-sdk-v2",
      "matchDatasources": [
        "go"
      ],
      "schedule": [
        "every month"
      ],
      "matchPackageNames": [
        "github.com/aws/aws-sdk-go-v2{/,}**"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "go run tool pins in the Makefile and pre-commit config",
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9./-]+(?:\\.[a-z]{2,})[^\\s@]*)@(?<currentValue>v[0-9][^\\s]*)"
      ],
      "datasourceTemplate": "go"
    }
  ],
  "postUpdateOptions": [
    "gomodUpdateImportPaths",
    "gomodTidy"
  ],
  "prHourlyLimit": 3,
  "minimumReleaseAge": "7 days",
  "timezone": "Europe/Paris"
}
